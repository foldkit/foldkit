{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["typedoc-entry.ts"],
  "tsconfig": "tsconfig.docs.json",
  "json": "../website/src/generated/api-ui.json",
  "pretty": false,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "intentionallyNotExported": [
    "BaseInitConfig",
    "BaseViewInputs",
    "BundleUpdateReturn",
    "FoldAnimationRequirements",
    "UpdateReturn",
    "ViewForItem",
    "src/animation/update.ts:UpdateRequirements",
    "src/radioGroup/index.ts:update",
    "src/tabs/index.ts:update"
  ]
}
