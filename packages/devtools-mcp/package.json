{
  "name": "@foldkit/devtools-mcp",
  "version": "0.19.4",
  "description": "MCP server exposing Foldkit DevTools to AI agents (Claude Code, Cursor, etc.)",
  "type": "module",
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "foldkit-devtools-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b && pnpm run bundle",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --allow-overwrite --alias:foldkit/devtools-protocol=../foldkit/src/devTools/public.ts --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112",
    "foldkit": ">=0.153.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "^0.28.2",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "foldkit",
    "mcp",
    "model-context-protocol",
    "devtools",
    "ai"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/devtools-mcp"
  },
  "homepage": "https://foldkit.dev/ai/mcp",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
