{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "foldkit": ["../src/index.ts"],
      "foldkit/block": ["../src/block/public.ts"],
      "foldkit/command": ["../src/command/public.ts"],
      "foldkit/message": ["../src/message/public.ts"],
      "foldkit/navigation": ["../src/navigation/public.ts"],
      "foldkit/program": ["../src/runtime/programPublic.ts"],
      "foldkit/runtime": ["../src/runtime/public.ts"],
      "foldkit/struct": ["../src/struct/public.ts"],
      "foldkit/url": ["../src/url/public.ts"],
      "foldkit/*": ["../src/*/public.ts"]
    },
    "skipLibCheck": false
  },
  "include": [
    "../src/vite-env.d.ts",
    "codec-contract.accepted.ts",
    "codec-contract.rejected.ts",
    "codec-contract.consume.ts"
  ]
}
