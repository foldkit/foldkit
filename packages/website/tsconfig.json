{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "vite.scripts.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*",
    "e2e/**/*"
  ],
  "exclude": ["src/snippet/**/*"]
}
