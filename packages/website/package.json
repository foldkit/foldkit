{
  "name": "website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../internal/api-reference-generator/generate.mjs",
    "dev": "vite",
    "prebuild": "node ../../internal/api-reference-generator/generate.mjs",
    "build": "export FOLDKIT_BUILD_ID=\"${FOLDKIT_BUILD_ID:-$(git rev-parse HEAD 2>/dev/null)}\"; vite build",
    "preview": "vite preview",
    "pretypecheck": "node ../../internal/api-reference-generator/generate.mjs",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "openapi": "tsx scripts/openApi.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "preprerender": "export FOLDKIT_BUILD_ID=\"${FOLDKIT_BUILD_ID:-$(git rev-parse HEAD 2>/dev/null)}\"; vite build --ssr src/entry.server.ts --outDir dist-server",
    "prerender": "tsx scripts/prerender.ts",
    "postprerender": "pagefind",
    "preview:search": "pnpm build && pnpm prerender && vite preview"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "@foldkit/devtools": "workspace:*",
    "@foldkit/markdown": "workspace:*",
    "@foldkit/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@webcontainer/api": "^1.6.4",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.112",
    "foldkit": "workspace:*",
    "monaco-editor": "^0.56.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@foldkit/api-reference-generator": "workspace:*",
    "@foldkit/vite-plugin": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.13",
    "image-size": "^2.0.2",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
