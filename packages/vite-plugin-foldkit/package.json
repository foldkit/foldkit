{
  "name": "@foldkit/vite-plugin",
  "version": "0.20.2",
  "description": "Vite plugin for Foldkit with state-preserving live reload",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.113",
    "foldkit": ">=0.159.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "magic-string": "^1.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "effect": "4.0.0-rc.113",
    "foldkit": "workspace:*",
    "happy-dom": "^20.11.13",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite7": "npm:vite@^7.3.6",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "foldkit",
    "live-reload",
    "state-preservation"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/vite-plugin-foldkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
