+/** Receiver-inferred Definition map constructor under investigation. */
+export interface MakeMapBindingMethod {
+  <
+    const ParentModelSchema extends AnySchema,
+    const ParentMessageSchema extends AnySchema,
+    const BlockValue extends BindableBlock,
+    const Keys extends MapBindingConfigKey,
+    const Field extends string,
+    const ChildField extends string,
+    const Source extends object,
+    const ParentOutMessageSchema extends AnySchema | undefined = undefined,
+    const ParentChildInitContextSchema extends AnySchema | undefined = undefined,
+  >(
+    this: Readonly<{
+      Model: ParentModelSchema
+      Message: ParentMessageSchema
+      OutMessage?: ParentOutMessageSchema
+      ChildInitContext?: ParentChildInitContextSchema
+      makeBinding: BindChild<
+        ParentModelSchema,
+        ParentMessageSchema,
+        ParentOutMessageSchema,
+        ParentChildInitContextSchema extends AnySchema
+          ? ParentChildInitContextSchema['Type']
+          : never
+      >
+    }>,
+    block: BlockValue,
+    config: Source &
+      Readonly<{ outMessage?: never }> &
+      ContextualProperties<
+        Keys,
+        BlockValue,
+        ParentModelSchema,
+        Field,
+        ChildField
+      > &
+      Readonly<{
+        field: Field &
+          ValidField<BlockValue, ParentModelSchema, Keys, ChildField>
+        childField?: ChildField
+      }> &
+      ([BlockValue['Message']['Type']] extends [never]
+        ? Readonly<{ delivery?: never }>
+        : DeliveryRequirement<
+            BlockValue,
+            ParentModelSchema['Type'],
+            KeyFor<ParentModelSchema, Field>
+          >),
+    ...validation: readonly [
+      ...ValidateConfig<BlockValue, NoInfer<Keys>, NoInfer<Source>>,
+      ...ValidateConcrete<BlockValue>,
+    ]
+  ): BindChildConstructorResult<
+    BlockValue,
+    ParentModelSchema,
+    ParentMessageSchema,
+    ParentOutMessageSchema,
+    ResultConfig<Source, ParentModelSchema, Field>,
+    ParentChildInitContextSchema extends AnySchema
+      ? ParentChildInitContextSchema['Type']
+      : never
+  >
+}
+
+
+/** Shared runtime adapter for the receiver-inferred constructor. */
+export const makeMapBindingMethod = ((): MakeMapBindingMethod =>
+  /* eslint-disable-next-line @typescript-eslint/consistent-type-assertions */
+  (function (this: object, block: BindableBlock, config: object): unknown {
+    return Reflect.apply(makeMapBinding, undefined, [this, block, config])
+  }) as unknown as MakeMapBindingMethod)()
