{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foldkit-domains",
  "main": "./dist/server/fetch.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "new_module_registry",
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "assets": {
    "directory": "./dist/client",
  },
}
