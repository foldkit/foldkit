{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@foldkit/oxlint-plugin/recommended.json"],
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "ignoreCase": false
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "repos/",
    "**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "**/*.config.js",
    "**/*.config.mjs"
  ],
  "overrides": [
    {
      "files": ["src/client/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+server(?:/|$)",
                "message": "Client application code imports shared contracts, never backend services."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["src/client/domainsQuery.test.ts"]
    },
    {
      "files": ["src/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:client|server)(?:/|$)",
                "message": "Shared contracts must be independent of client and server implementations."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**/*.ts"],
      "excludeFiles": ["src/server/entry.ts", "src/server/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+client(?:/|$)",
                "message": "Only the Worker entry renders the client application; backend services depend on shared contracts."
              }
            ]
          }
        ]
      }
    }
  ]
}
