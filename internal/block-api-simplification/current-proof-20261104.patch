+    block: PageBlock,
+    layer: pageLayer,
+    container: document.createElement('div'),
+    Flags: PageFlags,
+    routing: {
+      onUrlRequest: PageMessage.ChangedUrl,
+      onUrlChange: PageMessage.ClickedLink,
