+import { Effect, Layer, Schema } from 'effect'
+import * as Block from 'foldkit/block'
+
+import { HandlerBuild, type HandlerFailure, RequestSource, SelectedNotes } from './contracts.js'
+import { layer as NotesLayer } from './implementation.js'
+
+const ParentKey=Symbol('ConsumerFamilyParent')
+export const ParentBlock=Block.make('ConsumerFamilyParent',{
+  key:ParentKey,Model:Schema.Struct({notes:SelectedNotes.Model}),Message:Schema.Never,Init:Schema.Tuple([]),
+  effects:Block.makeEffectsContract<HandlerFailure,HandlerBuild|RequestSource>(),
+})
+const NotesBinding=ParentBlock.makeBinding(SelectedNotes,{field:'notes'})
+const Composition=ParentBlock.makeComposition({bindings:[NotesBinding]})
+export const layer=ParentBlock.makeLayer(Effect.gen(function*(){
+  const notes=yield* NotesBinding
+  return {children:[notes],init:Composition.makeInit(()=>({model:{}})),update:Composition.makeUpdate({})}
+})).pipe(Layer.provide(NotesLayer))
