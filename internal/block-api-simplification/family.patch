@@ -0,0 +1,22 @@
+import { Context, Effect, Layer, Option, Schema } from 'effect'
+import * as AsyncData from 'foldkit/asyncData'
+import * as Query from 'foldkit/experimental/query'
+
+import { SelectedNotes } from './contracts.js'
+
+export class GraphService extends Context.Service<GraphService, Readonly<{value:number}>>()('Consumer/GraphService') {}
+export const Composition=SelectedNotes.makeComposition()
+const noop=SelectedNotes.makeNoopStep()
+export const init=Composition.makeInit(()=>({model:SelectedNotes.Model.make({data:AsyncData.Idle(),generation:5,maybeCompletedAtMillis:Option.none()})}))
+export const update=Composition.makeUpdate({
+  RequestedLoadIfStale:model=>({model,commands:[SelectedNotes.Fetch({generation:model.generation+1})]}),
+  CompletedFetch:noop,CompletedCancelFetch:noop,
+})
+export const receive=Composition.makeReceive({RequestedReset:noop,RequestedRevalidation:noop,RequestedRevalidationOrLoad:noop,RequestedLoadIfMissing:noop,RequestedCancel:noop})
+export const GraphFailure=Schema.Struct({reason:Schema.String})
+export type GraphFailure=typeof GraphFailure.Type
+export const layer=SelectedNotes.makeLayer(Effect.gen(function*(){
+  const graph=yield* GraphService
+  if(graph.value<0){return yield* Effect.fail(GraphFailure.make({reason:'graph'}))}
+  return {children:[],init,update,receive,EffectsLayer:Layer.empty,hostHandlers:[SelectedNotes.Fetch]}
+})).pipe(Layer.provide(Query.layer))
