@@ -0,0 +1,21 @@
+import { Context, Effect, Schema } from 'effect'
+import * as Query from 'foldkit/experimental/query'
+
+export class HandlerBuild extends Context.Service<HandlerBuild, Readonly<{isFailure:boolean}>>()('Consumer/HandlerBuild') {}
+export class RequestSource extends Context.Service<RequestSource, Readonly<{value:number}>>()('Consumer/RequestSource') {}
+export const HandlerFailure=Schema.Struct({reason:Schema.String})
+export type HandlerFailure=typeof HandlerFailure.Type
+export const Notes=Query.define({name:'ConsumerNotes',data:Schema.NumberFromString,error:Schema.String})
+export const handlers=Notes.toLayer(Effect.gen(function*(){
+  const build=yield* HandlerBuild
+  if(build.isFailure){
+    return yield* Effect.fail(HandlerFailure.make({reason:'unavailable'}))
+  }
+  return ()=>Effect.map(RequestSource,source=>source.value)
+}))
+export const SelectedNotes=Notes.provideHandlers(handlers)
+export const AttachedNotes=Query.define({name:'AttachedNotes',data:Schema.NumberFromString,error:Schema.String,handler:function*(){
+  const build=yield* HandlerBuild
+  if(build.isFailure){return yield* Effect.fail(HandlerFailure.make({reason:'unavailable'}))}
+  return ()=>Effect.map(RequestSource,source=>source.value)
+}})
