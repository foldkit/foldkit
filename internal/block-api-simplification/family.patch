diff --git a/packages/ui/src/fixedFamilyLayer.test.ts b/packages/ui/src/fixedFamilyLayer.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/fixedFamilyLayer.test.ts
@@ -0,0 +1,126 @@
+import { Effect, Schema } from 'effect'
+import { Story } from 'foldkit'
+import * as Block from 'foldkit/block'
+import { describe, expect, expectTypeOf } from 'vitest'
+
+import { it } from '@effect/vitest'
+
+import { FocusListboxItems } from './listbox/command.js'
+import * as Listbox from './listbox/single.js'
+import * as VirtualList from './virtualList/virtualList.js'
+
+const Fruit = Schema.Struct({
+  id: Schema.Literals(['Apple', 'Pear']),
+  label: Schema.String,
+})
+type Fruit = typeof Fruit.Type
+const Fruits = Listbox.makeBlock<Fruit, 'Apple' | 'Pear'>()
+const Apple = Listbox.makeBlock<string, 'Apple'>()
+const Rows = VirtualList.makeBlock<Fruit>()
+const FruitComposition = Fruits.makeComposition()
+FruitComposition.makeView.withInputs((_model, inputs, h) => {
+  expectTypeOf(inputs).toEqualTypeOf<
+    Listbox.ViewInputs<Fruit, 'Apple' | 'Pear'>
+  >()
+  return h.div(
+    [],
+    inputs.items.map(item => item.label),
+  )
+})
+Fruits.makeOutMessageStep(() => Fruits.OutMessage.Selected({ value: 'Pear' }))
+const RowsComposition = Rows.makeComposition()
+RowsComposition.makeView.withInputs((_model, inputs, h) => {
+  expectTypeOf(inputs).toEqualTypeOf<VirtualList.ViewInputs<Fruit>>()
+  return h.div(
+    [],
+    inputs.items.map(item => item.label),
+  )
+})
+
+expectTypeOf<Effect.Services<typeof Fruits.get>>().toEqualTypeOf<
+  Effect.Services<typeof Listbox.canonicalBlock.get>
+>()
+expectTypeOf<Effect.Services<typeof Rows.get>>().toEqualTypeOf<
+  Effect.Services<typeof VirtualList.canonicalBlock.get>
+>()
+expectTypeOf<
+  Block.FactsOf<typeof Apple>['operations']['requestSelectItem']['args']
+>().toEqualTypeOf<readonly [item: 'Apple']>()
+
+if (false) {
+  Apple.makeOutMessageStep(() =>
+    // @ts-expect-error OutMessage helpers preserve the refined Value.
+    Listbox.canonicalBlock.OutMessage.Selected({ value: 'Pear' }),
+  )
+  FruitComposition.makeView.withInputs((_model, inputs, h) => {
+    // @ts-expect-error Item callbacks preserve the refined Schema-backed row.
+    const wrong: number = inputs.items.at(0)?.label
+    return h.div([], [String(wrong)])
+  })
+  // @ts-expect-error Factory results are unified Blocks with direct completion.
+  void Fruits.contract
+  // @ts-expect-error A factory does not expose another implementation-description stage.
+  void Rows.makeBlock
+}
+
+describe('fixed-schema unified Block factories', () => {
+  it.effect(
+    'shares the Listbox implementation across refined public factories',
+    () =>
+      Effect.gen(function* () {
+        expect(Fruits).toBe(Apple)
+        expect(Fruits).toBe(Listbox.canonicalBlock)
+        expect('contract' in Fruits).toBe(false)
+        expect(typeof Fruits.makeLayer).toBe('function')
+        const first = yield* Fruits.get
+        const second = yield* Apple.get
+        expect(first).toBe(second)
+        const initial = first.init({ id: 'fruit' })
+        const selected = first.operations.requestSelectItem(
+          initial.model,
+          'Pear',
+        )
+        expect(selected.outMessage).toEqual(
+          Fruits.OutMessage.Selected({ value: 'Pear' }),
+        )
+        expectTypeOf(selected.outMessage?.value).toEqualTypeOf<
+          'Apple' | 'Pear' | undefined
+        >()
+      }).pipe(Effect.provide(Listbox.layer)),
+  )
+
+  it.effect(
+    'shares VirtualList and preserves refined history operation inputs',
+    () =>
+      Effect.gen(function* () {
+        const MoreRows = VirtualList.makeBlock<number>()
+        expect(Rows).toBe(MoreRows)
+        const first = yield* Rows.get
+        const second = yield* MoreRows.get
+        expect(first).toBe(second)
+        const initial = first.init({ id: 'rows', rowHeightPx: 20 })
+        const prepend = first.operations.informHistoryPrepended(initial.model, {
+          items: [Fruit.make({ id: 'Apple', label: 'Apple' })],
+          prependedItems: [],
+          itemToKey: item => item.id,
+          page: VirtualList.HistoryPage.More(),
+        })
+        expect(prepend.model).toBeDefined()
+      }).pipe(Effect.provide(VirtualList.layer)),
+  )
+
+  it.effect(
+    'uses refined contracts in Block-aware pure runners without browser handlers',
+    () =>
+      Story.story(
+        Apple,
+        Story.init({ id: 'apple' }),
+        Story.inMessage(Apple.InMessage.RequestedOpen()),
+        Story.Command.resolve(
+          FocusListboxItems,
+          Apple.Message.CompletedFocusListboxItems(),
+        ),
+        Story.model(model => expect(model.isOpen).toBe(true)),
+      ).pipe(Effect.provide(Listbox.layer)),
+  )
+})
