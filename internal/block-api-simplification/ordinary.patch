+import { Context, Effect, Layer, Schema } from 'effect'
+
+import * as Block from '../packages/foldkit/dist/block/public.js'
+import * as Program from '../packages/foldkit/dist/runtime/programPublic.js'
+import * as Server from '../packages/foldkit/dist/experimental/server/public.js'
+import { __htmlBuilder } from '../packages/foldkit/dist/html/index.js'
+
+class ChildService extends Context.Service<
+  ChildService,
+  Readonly<{ value: number }>
+>()('foldkit/test/DirectLayerRelocatedChildService') {}
+
+class ParentService extends Context.Service<
+  ParentService,
+  Readonly<{ value: string }>
+>()('foldkit/test/DirectLayerRelocatedParentService') {}
+
+const ChildModel = Schema.Struct({ value: Schema.Number })
+const ChildMessage = Schema.Never
+const ChildKey = Symbol('DirectLayerRelocatedChild')
+const Child = Block.make('DirectLayerRelocatedChild', {
+  key: ChildKey,
+  Model: ChildModel,
+  Message: ChildMessage,
+  isMessageFree: true,
+  Init: Schema.Tuple([]),
+})
+const ChildComposition = Child.makeComposition()
+const childLayer = Child.makeLayer(
+  Effect.gen(function* () {
+    const childService = yield* ChildService
+
+    return {
+      children: [],
+      init: ChildComposition.makeInit(() => ({
+        model: { value: childService.value },
+      })),
+      update: ChildComposition.makeUpdate({}),
+    }
+  }),
+)
+
+const ParentModel = Schema.Struct({ child: ChildModel })
+const ParentMessage = Schema.Never
+const ParentKey = Symbol('DirectLayerRelocatedParent')
+const Parent = Block.make('DirectLayerRelocatedParent', {
+  key: ParentKey,
+  Model: ParentModel,
+  Message: ParentMessage,
+  isMessageFree: true,
+  Init: Schema.Tuple([]),
+  view: { kind: 'Element' },
+})
+const ChildBinding = Parent.makeBinding(Child, { field: 'child' })
+const ParentComposition = Parent.makeComposition({ bindings: [ChildBinding] })
+const parentView = ParentComposition.makeView((model, h) =>
+  h.div([], [String(model.child.value)]),
+)
+const parentLayer = Parent.makeLayer(
+  Effect.gen(function* () {
+    const parentService = yield* ParentService
+    const child = yield* ChildBinding
+
+    return {
+      children: [child],
+      init: ParentComposition.makeInit(() => ({ model: {} })),
+      update: ParentComposition.makeUpdate({}),
+      view: parentView,
+    }
+  }),
+)
+const selectedLayer = Layer.provide(
+  Layer.provide(parentLayer, Layer.provide(childLayer, Layer.succeed(ChildService, { value: 1 }))),
+  Layer.succeed(ParentService, { value: 'parent' }),
+)
+const pendingProgram = Program.makeElement({
+  block: Parent,
+  layer: selectedLayer,
+  container: null,
+})
+
+type Equal<Left, Right> = [Left, Right] extends [Right, Left] ? true : false
+type Assert<Condition extends true> = Condition
+
+type ParentServicesIncludeHost = Assert<ParentService extends Layer.Services<typeof parentLayer> ? true : false>
+type SelectedServicesAreExact = Assert<
+  Equal<Layer.Services<typeof selectedLayer>, never>
+>
+type ParentErrorsAreExact = Assert<
+  Equal<Layer.Error<typeof parentLayer>, never>
+>
+type IsAny<Value> = 0 extends (1 & Value) ? true : false
+type ProgramIsNotAny = Assert<IsAny<typeof pendingProgram> extends false ? true : false>
+
+const DocumentModel = Schema.Struct({ title: Schema.String })
+const DocumentMessage = Schema.Never
+const DocumentKey = Symbol('DirectLayerRelocatedDocument')
+const DocumentBlock = Block.make('DirectLayerRelocatedDocument', {
+  key: DocumentKey,
+  Model: DocumentModel,
+  Message: DocumentMessage,
+  isMessageFree: true,
+  Init: Schema.Tuple([]),
+  view: { kind: 'Document' },
