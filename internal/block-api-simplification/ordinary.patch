+
+/** @internal Exact implementation facts carried by an ordinary completed Layer. */
+export interface ImplementationFacts<OwnerValue, Facts, Pending = never> {
+  readonly [LayerOriginalFactsTypeId]: Readonly<{
+    owner: OwnerValue
+    facts: Facts
+    pending: Pending
+  }>
+}
