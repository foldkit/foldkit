{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] },
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown",
    ],
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-server",
    "dist-scripts",
    "**/public/example-apps-embed",
    // Generated by packages/website/scripts/openApi.ts, byte-compared in agentSurface.test.ts.
    "packages/website/public/openapi.json",
    // Generated by packages/website/scripts/generate-block-contracts.mjs, byte-compared by its --check mode.
    "packages/website/src/**/*.contract.ts",
    "packages/website/contract-witnesses/*.witness.ts",
    "packages/website/contract-witnesses/*.channels.ts",
    // One mutation per line, so each @ts-expect-error covers its whole call.
    "packages/foldkit/declaration-tests/assemble-as.rejected.ts",
    "packages/website/contract-witnesses/assemble-as.mutations.ts",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "playwright-report/",
    "test-results/",
    "repos/",
    "packages/oxlint-plugin-foldkit/test/integration/fixtures/",
  ],
}
