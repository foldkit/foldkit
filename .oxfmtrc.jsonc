{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] },
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown",
    ],
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-server",
    "**/public/example-apps-embed",
    // Generated by packages/website/scripts/openApi.ts, byte-compared in agentSurface.test.ts.
    "packages/website/public/openapi.json",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "playwright-report/",
    "test-results/",
    "repos/",
    "packages/oxlint-plugin-foldkit/test/integration/fixtures/",
  ],
}
