{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] },
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown",
    ],
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-server",
    "dist-scripts",
    "**/public/example-apps-embed",
    // Generated by packages/website/scripts/openApi.ts, byte-compared in agentSurface.test.ts.
    "packages/website/public/openapi.json",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "playwright-report/",
    "test-results/",
    "repos/",
    "packages/oxlint-plugin-foldkit/test/integration/fixtures/",
    // Generated compiler output and immutable research captures.
    "probe/",
    "internal/**/measurements/",
    "internal/**/.relocated/",
    "internal/**/artifacts/",
    "internal/**/declarations/",
    "internal/**/emitted/",
    "internal/**/node-dist/",
    "internal/**/diagnosis/",
    "internal/**/results.json",
    "internal/layered-constructor/comparison/sam-*/",
    "internal/layered-constructor/generic-identity/baseline/",
    "internal/layered-constructor/inmessages/baseline/",
    "internal/layered-constructor/query-contract/review/production-declarations/before/",
    "internal/layered-constructor/showcase-chat/provenance.json",
    "internal/layered-constructor/contract-provisioning/results/pre-canonical-emitted/",
    "internal/layered-constructor/hover/inputs/",
    "internal/layered-constructor/domains-app/provenance/",
    "internal/layered-constructor/guidance-contract-*/",
  ],
}
